# AI provider configuration.
#
# Copy this file to `.env` (which is git ignored) and fill in the values, then
# start the app with `pnpm dev:local` so the variables are loaded into the
# server process.
#
# On Cloudflare the same values are provided as worker bindings.

# Which provider the server talks to: `anthropic` (default) or `openrouter`.
AI_PROVIDER=anthropic

# The API key of the selected provider.
#   anthropic -> ANTHROPIC_API_KEY
#   openrouter -> OPENROUTER_API_KEY
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: restrict the models the client may choose from. The value is a
# comma separated list of model ids that have to be part of the catalogue of
# the selected provider.
# AI_MODELS=claude-3-5-sonnet-20240620,claude-3-opus-20240229

# Optional: OpenRouter specific settings.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-app.example.com
# OPENROUTER_SITE_NAME=Your App Name
