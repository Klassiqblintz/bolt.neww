# The Anthropic API key used by the AI provider.
#
# Copy this file to `.env` (which is git ignored) and paste your key, then
# start the app with `pnpm dev:local` so the key is loaded into the server
# process.
#
# On Cloudflare the key is provided as a `ANTHROPIC_API_KEY` binding instead.
ANTHROPIC_API_KEY=
